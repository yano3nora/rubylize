{
  "tasks": {
    "dev": "deno test --allow-read --allow-env --watch",
    "check": "deno fmt --check && deno lint && deno check main.ts scripts/release.ts",
    "test": "deno test --allow-read --allow-env",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "compile": "deno compile --allow-read --allow-env --output rubylize main.ts"
  },
  "fmt": {
    "exclude": ["README.md", "dist/"],
    "singleQuote": true,
    "semiColons": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "kuromojin": "npm:kuromojin@3.0.0"
  }
}
